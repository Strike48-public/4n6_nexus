# 4n6 Nexus - Environment Configuration Template
# Copy this file to .env and fill in your values
# cp .env.example .env

# === Application Configuration ===
APP_NAME=4n6_nexus
APP_DOMAIN=your-domain.com

# === Case Management ===
# Root directory for case files (must have write access)
CASE_ROOT=/cases
# Or use a local directory: CASE_ROOT=./cases

# === Evidence Processing ===
# Directory containing evidence files
EVIDENCE_ROOT=/path/to/evidence
# Working directory for analysis outputs
ANALYSIS_ROOT=/path/to/analysis

# === Audit Logging ===
# Path to audit log file (JSONL format)
AUDIT_LOG_PATH=/path/to/audit.jsonl

# === MCP Server Configuration ===
# MCP server stdio endpoint (used by Claude Code integration)
MCP_SERVER_COMMAND=python -m sift_find_evil.mcp
MCP_CASE_ROOT=/cases
MCP_EVIDENCE_ROOT=/cases/evidence
MCP_AUDIT_PATH=/cases/audit.jsonl

# === SIFT Workstation Tools (Optional - for real evidence processing) ===
# Paths to forensic tools - these are typically provided by SIFT Workstation
# Leave blank if using synthetic fixtures only

# EZ Tools (Windows artifact parsing)
EZTOOLS_ROOT=/opt/zimmermantools
MFTECMD=/opt/zimmermantools/net6/MFTECmd
PECMD=/opt/zimmermantools/net6/PECmd
EVTXECMD=/opt/zimmermantools/net6/EvtxECmd
RECMD=/opt/zimmermantools/net6/RECmd

# Volatility 3 (memory analysis)
VOLATILITY3=/opt/volatility3/vol.py

# Sleuth Kit (file system analysis)
TSK_ROOT=/usr/bin
FLS=/usr/bin/fls
ICAT=/usr/bin/icat
MMLS=/usr/bin/mmls

# YARA (malware scanning)
YARA=/usr/bin/yara
YARA_RULES_DIR=./rules/yara

# === Email Configuration (Optional - for notifications) ===
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=your-email@example.com
SMTP_PASSWORD=change-me-to-your-password
SMTP_FROM=noreply@your-domain.com

# === API Keys (Optional - for threat intelligence integrations) ===
# VirusTotal API key (for hash/IP/domain lookups)
VIRUSTOTAL_API_KEY=your-virustotal-api-key-here

# AbuseIPDB API key (for IP reputation checks)
ABUSEIPDB_API_KEY=your-abuseipdb-api-key-here

# === Security Settings ===
# Secret key for session management (generate with: python -c "import secrets; print(secrets.token_hex(32))")
SECRET_KEY=change-me-to-a-random-64-character-hex-string

# === Development Settings ===
# Set to 'true' to enable debug logging
DEBUG=false

# Test fixture directory (for development)
TEST_FIXTURES_DIR=./scenarios/synthetic

# === Cloud Storage (Optional - for evidence backup) ===
# AWS S3 bucket for evidence archival
AWS_S3_BUCKET=your-evidence-bucket
AWS_REGION=us-east-1
# AWS credentials should be configured via AWS CLI or IAM roles
# Never hardcode AWS_ACCESS_KEY_ID or AWS_SECRET_ACCESS_KEY here

# === Database (Future - not yet implemented) ===
# DATABASE_URL=postgresql://user:password@localhost:5432/4n6_nexus
