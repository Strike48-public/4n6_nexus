*.swp
*.swo
*~
.DS_Store

# Testing
.pytest_cache/
.coverage
coverage.json
coverage.xml
htmlcov/
*.cover
.hypothesis/

# Evidence files (can be large, should not be committed)
evidence/*
!evidence/.gitkeep

# Scenario harness outputs (regenerated on every run)
analysis/scenario_*.json
analysis/demo_*.json
analysis/demo_run/
analysis/bypass_run/

# Local MCP / demo audit byproduct. The repo-root audit.jsonl is the default
# audit path in .mcp.json (`${SFE_AUDIT_PATH:-./audit.jsonl}`); it is written
# whenever the project-scoped MCP server or a local demo runs, and must never
# be committed. Real-case audit logs live under the case root, not here.
/audit.jsonl

# Scenario analysis outputs (derived from evidence, not shipped)
analysis/*/extracted/
analysis/*/csv/
analysis/*/logs/
analysis/scenario_testing/

# Sweep directory (evidence-derived artifacts, should not be committed)
analysis/sweep/

# Carved / extracted binaries recovered from evidence (SFE-9z3). These are
# evidence-derived and can trip GitHub malware/push-protection; keep them in the
# local analysis/ workspace only, never in git.
analysis/**/carved_executables/
analysis/**/extracted_files/
analysis/**/*.exe
analysis/**/*.raw.info
analysis/**/memory/*.info

# Scenario evidence - downloaded binary files live under scenarios/**/evidence/
# and reference corpora, never in git.
scenarios/**/evidence/
!scenarios/**/evidence/.gitkeep

# Analysis output + evidence-derived data (per CLAUDE.md output routing to
# ./exports/). Real-evidence extractions (e.g. an extracted $MFT) and findings
# JSON must never be committed. Keep curated demo artifacts under demo/ instead.
exports/
scenarios/reference/mobile/
scenarios/reference/nist-nps/
scenarios/reference/circl-drives/
scenarios/reference/network-pcaps/
scenarios/reference/govdocs/
scenarios/reference/sql/
scenarios/reference/cfreds/*/*.zip
scenarios/reference/cfreds/*/*.dd
scenarios/reference/cfreds/*/*.sha1
scenarios/reference/safedocs/
scenarios/reference/unsafe_docs/

*.E0[0-9]
*.Ex[0-9]
*.e0[0-9]
*.dd
*.raw
*.img
*.vmdk
*.vdi
*.ova
*.ovf
*.pcap
*.pcapng
*.mem
*.dmp
*.bin

# Case outputs (investigation results)
cases/*
!cases/.gitkeep

# Logs (except sample logs for documentation)
logs/*
!logs/sample_investigation.jsonl
!logs/.gitkeep

# Node / npm (MCP server deps, e.g. tavily-mcp) - reinstall from package-lock.json
node_modules/

# Timestamped synthetic test-run outputs (regenerated; curated results stay tracked)
test-results/synthetic/

# Temporary files
*.tmp
*.bak
*.log

# Jupyter notebooks
.ipynb_checkpoints/

# Model checkpoints (if using ML)
*.pth
*.h5
*.pb

# Environment variables
.env
.env.local

# Claude Code specific -- ignore local settings/reviews, but TRACK the multi-agent
# definitions: they ARE the product's agentic layer and must ship in the public
# submission repo so judges can deploy and inspect it.
.claude/*
!.claude/agents/
.claude/agents/README.md

