# Scenario harness outputs (regenerated on every run)
analysis/scenario_*.json

# Real-example extracted artifacts (derived from practice_images/, not shipped)
analysis/real_examples/*/extracted/
analysis/real_examples/*/csv/
analysis/real_examples/*/logs/

# Disk images and VM assets (multi-GB, ship out-of-band)
practice_images/
*.E0[0-9]
*.Ex[0-9]
*.e0[0-9]
*.dd
*.raw
*.img
*.vmdk
*.vdi
*.ova
*.ovf

# Case outputs (investigation results)
cases/*
!cases/.gitkeep

# Logs (except sample logs for documentation)
logs/*
!logs/sample_investigation.jsonl
!logs/.gitkeep

# Temporary files
*.tmp
*.bak
*.log

# Jupyter notebooks
.ipynb_checkpoints/

# Model checkpoints (if using ML)
*.pth
*.h5
*.pb

